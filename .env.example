# Скопируйте в .env и при необходимости измените.
APP_NAME=FastAPI KR4

# SQLite (по умолчанию, работает без внешних сервисов и без нативных драйверов):
DATABASE_URL=sqlite:///./app.db

# Пример для PostgreSQL (драйвер psycopg 3, используется в docker-compose):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/kr4
